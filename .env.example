# ============================================
# SC-TCG Configuration
# Copy this file to .env and fill in the values
# ============================================

# ---- SonarQube ----
SONAR_TOKEN=
SONAR_HOST_URL=http://localhost:9000
SONAR_PROJECT_KEY=sc-tcg-card-view

# ---- GitHub ----
GITHUB_PAT=
GITHUB_API_URL=https://api.github.com
GITHUB_OWNER=julien-amiot
GITHUB_REPO=tcg-viewer
GITHUB_PAGES_BRANCH=gh-pages
GITHUB_BASE_URL=https://github.com/julien-amiot/tcg-viewer

# ---- Jira ----
JIRA_URL=https://cairnworks.atlassian.net
JIRA_EMAIL=
JIRA_TOKEN=
JIRA_PROJECT_KEY=TCGV
JIRA_PROJECT_ID=10047
JIRA_ISSUE_TYPE=Task
JIRA_TEST_EXECUTION_TYPE=Test execution

# ---- Playwright / Dev Server ----
PLAYWRIGHT_BASE_URL=http://localhost:3000

# ---- Docker / SonarQube ----
SONAR_DOCKER_IMAGE=sonarqube:community
SONAR_CONTAINER_NAME=sc-tcg-sonarqube
SONAR_DB_CONTAINER_NAME=sc-tcg-sonarqube-db
SONAR_JDBC_URL=jdbc:postgresql://db:5432/sonar
SONAR_JDBC_USERNAME=sonar
SONAR_JDBC_PASSWORD=sonar
SONAR_HOST_PORT=9000
SONAR_DB_PORT=5432

# ---- Application ----
APP_NAME=SC-TCG Card Viewer
APP_VERSION=0.2.0