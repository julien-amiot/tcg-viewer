{
  "name": "sc-tcg-card-view",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "node scripts/build.js",
    "copy:assets": "node scripts/copy-assets.js",
    "test": "vitest --run --pool=forks --no-file-parallelism",
    "test:unit": "vitest run --pool=forks --no-file-parallelism",
    "test:e2e": "playwright test",
    "test:e2e:jira": "node scripts/run-e2e-with-jira.js",
    "e2e:issues": "node scripts/create-e2e-issues.js",
    "sonar:scan": "sonar-scanner",
    "sonar:start": "docker compose -f docker-compose.sonar.yml up -d",
    "sonar:stop": "docker compose -f docker-compose.sonar.yml down"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@vitest/coverage-v8": "^4.1.8",
    "esbuild": "^0.28.1",
    "jsdom": "^29.1.1",
    "playwright": "^1.45.0",
    "playwright-bdd": "^9.0.0",
    "serve": "^14.2.0",
    "sonarqube-scanner": "^4.3.8",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}